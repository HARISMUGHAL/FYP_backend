## ──────────────────────────────────────────────────
##  FruitGrade System — Master Configuration
## ──────────────────────────────────────────────────
## Supports BOTH legacy ("data") and new ("dataset") keys.
## The ML pipeline uses flexible .get() lookups for safety.

# ── NEW-FORMAT dataset path ────────────────────────
dataset:
  path: "FruitGrade_Dataset"
  img_size: 224
  batch_size: 32
  num_workers: 0
  val_split: 0.2

# ── LEGACY data section (kept for backward compat) ─
data:
  raw_dir: "FruitGrade_Dataset"
  train_dir: "ml/data/train"
  val_dir: "ml/data/val"
  test_dir: "ml/data/test"
  image_extensions: [".jpg", ".jpeg", ".png"]
  skip_folders: ["real"]
  split_seed: 42
  train_ratio: 0.7
  val_ratio: 0.2
  test_ratio: 0.1
  min_file_size_bytes: 1024

# ── Preprocessing / Augmentation ───────────────────
preprocessing:
  image_size: 224
  resize_size: 256
  center_crop: 224
  mean: [0.485, 0.456, 0.406]
  std:  [0.229, 0.224, 0.225]
  random_horizontal_flip: true
  random_rotation_deg: 15
  color_jitter:
    brightness: 0.3
    contrast: 0.3
    saturation: 0.3
    hue: 0.1
  random_resized_crop:
    enabled: true
    scale_min: 0.60
    scale_max: 1.00
  random_grayscale_prob: 0.10

# ── Model ──────────────────────────────────────────
model:
  name: "efficientnet_b0"
  pretrained: true
  dropout_rate: 0.4
  save_path: ml/models/saved/model_v2.pth

# ── Training ───────────────────────────────────────
training:
  epochs: 10
  lr: 0.0003
  patience: 3
  early_stopping: true
  batch_size: 32
  num_workers: 0
  pin_memory: false

# ── Inference ──────────────────────────────────────
inference:
  device: "cpu"
  confidence_threshold: 0.55

# ── Detection (YOLO) ──────────────────────────────
detection:
  weights: "yolov8n.pt"
  conf_threshold: 0.15
  iou_threshold: 0.45
  filter_coco_ids: []
  fallback_full_image: true
